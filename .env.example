# AD Robot — every variable this project reads, with values that work as they stand.
#
#     cp .env.example .env && docker compose up
#
# The ADROBOT_ block is the declared field set of backend/src/adrobot/settings.py, name
# for name, and a field and its line here move in the same commit. That is checked two
# ways: tests/test_settings.py parses this file and compares it with the model, and both
# boot guards name the variable they are unhappy about — an ADROBOT_* name no field
# claims stops the service ("a typo or a stale export"), and so does a required name with
# no value. An EMPTY value counts as unset, so `ADROBOT_ACCESS_TOKEN=` is a refusal to
# start rather than a service with no authentication.
#
# Nothing below is a credential. The two values that must be replaced before this service
# can reach a real tracker begin with `replace-me`, so `grep replace-me .env` answers
# "what is still fake?", and the tracker host is `.invalid` — a TLD RFC 2606 guarantees
# will never resolve, so a half-configured stack cannot post an Api-Key header at
# somebody else's server.

# What the process is: dev or prod. No default — `dev` reached by accident in production
# would serve /docs and human-readable logs.
ADROBOT_ENV=dev

# DEBUG | INFO | WARNING | ERROR | CRITICAL. Optional, and written out anyway: this file
# is the whole list, and a name that lives only in the source is a name nobody can find.
ADROBOT_LOG_LEVEL=INFO

# The scheme is checked at boot — `postgresql+asyncpg` and nothing else, because the
# engine is async and a synchronous driver would surface as MissingGreenlet on the first
# query instead of at start-up. `db` is the compose service name; from the host (psql,
# and the stage-5 database tests) the same cluster is at 127.0.0.1:5432.
ADROBOT_DATABASE_URL=postgresql+asyncpg://adrobot:adrobot@db:5432/adrobot

# The one shared token on the mutating endpoints (PLAN-BACKEND §9: no user table, no
# JWT). Shipped with a value on purpose — the four-command start above is only true if
# this file satisfies the boot guards — and with a value nobody can mistake for a real
# one. Replace it before anything but 127.0.0.1 can reach this service.
ADROBOT_ACCESS_TOKEN=replace-me-dev-access-token-not-a-secret

# Keitaro Admin API base, including the /admin_api/v1 prefix the tracker's own docs show.
# Validated at boot: https, no credentials in the URL, no query and no fragment.
ADROBOT_KEITARO_BASE_URL=https://tracker.invalid/admin_api/v1

# The tracker's Admin API key. Held as a SecretStr and sent in an Api-Key header, so the
# host above is the host that receives it. Nothing calls the tracker before stage 4,
# which is why a placeholder is enough to bring the whole stack up today.
ADROBOT_KEITARO_API_KEY=replace-me-not-a-real-keitaro-admin-api-key

# Where preview and "VIEW IN KT" links point: the same tracker without /admin_api/v1.
# Same three checks as the Admin API base.
ADROBOT_KEITARO_PUBLIC_BASE_URL=https://tracker.invalid

# IANA name, resolved through zoneinfo at boot. Keitaro serialises timestamps without an
# offset, in the tracker's own zone; from stage 4 this is overwritten by GET /settings.
ADROBOT_KEITARO_TIMEZONE=UTC

# --- Postgres: read by docker-compose.yml, and by nothing in the application ----------
# The prefix guard ignores unprefixed names, so these three reach the api container
# harmlessly. They are the user, password and database inside ADROBOT_DATABASE_URL
# above: compose cannot slice a URL, so this is one credential written twice — and it is
# written twice HERE so the two copies sit a few lines apart rather than a file apart.
POSTGRES_USER=adrobot
POSTGRES_PASSWORD=adrobot
POSTGRES_DB=adrobot
